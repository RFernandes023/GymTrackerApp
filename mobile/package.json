{
  "name": "@gym/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "jest",
    "test:all": "vitest run && jest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gym/shared": "*",
    "@hookform/resolvers": "^7.0.6",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@tanstack/react-query": "^5.107.1",
    "@types/jest": "^30.0.0",
    "expo": "~58.0.25",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-keep-awake": "~58.0.4",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "react": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "^19.3.0",
    "react-test-renderer": "^19.3.0",
    "typescript": "~5.9.0",
    "vitest": "^3.2.7"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/__rn__/**/*.test.tsx"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/__rn__/setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ]
  }
}
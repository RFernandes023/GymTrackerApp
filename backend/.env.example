# Copiar para .env e preencher. NUNCA fazer commit do .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# MongoDB Atlas (cluster gratuito): Database > Connect > Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gymtracker?retryWrites=true&w=majority
# Segredo longo e aleatório (>= 32 chars). Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Client IDs OAuth Google aceites como audience (separados por vírgula): o Web client ID e, se aplicável, o Android client ID
GOOGLE_CLIENT_IDS=
# Origens CORS permitidas (apps nativas não usam CORS; relevante para web/dev). Vírgulas.
CORS_ORIGINS=

# --- Treinador IA (opcional; por defeito desligado → a app usa só análises locais) ---
# AI_PROVIDER=none | gemini | openai
AI_PROVIDER=none
# Chave do Google AI Studio (https://aistudio.google.com). NUNCA colocar no código mobile.
GEMINI_API_KEY=
# Os nomes de modelos mudam e alguns são descontinuados: confirmar na documentação atual e nos limites do teu projeto.
GEMINI_MODEL=gemini-2.5-flash
# Alternativa compatível com /chat/completions
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Limites por utilizador e por dia (UTC)
AI_DAILY_LIMIT=40
AI_MEAL_PHOTO_DAILY_LIMIT=10
AI_COST_NOTE=Sem custo enquanto estiveres dentro dos limites gratuitos do fornecedor; acima disso o fornecedor pode cobrar.
